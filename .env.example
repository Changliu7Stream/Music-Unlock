# MusicUnlock 后端解密服务 - 环境变量配置
# 复制此文件为 .env 并填入实际密钥值
# 所有密钥均为格式规范中的公开常量，可从 unlock-music / parakeet-crypto-rs 等开源项目获取

# === NCM (网易云音乐) ===
# NCM 核心密钥，用于解密文件内嵌的主密钥（字符串）
NCM_CORE_KEY=hzHRAmso5kInbaxW
# NCM 标签密钥，用于解密歌曲信息（可选，不设则使用库默认值）
# NCM_TAG_KEY=

# === QMCv2 (QQ音乐新版 mflac/mgg) ===
# 方式一：直接提供 core_key（hex 编码，8 字节 = 16 hex 字符）
# QMCV2_CORE_KEY=695646382b20150b
# 方式二：通过 salt+length 派生（库默认 salt=106, length=8）
QMCV2_CORE_KEY_SALT=106
QMCV2_CORE_KEY_LENGTH=8

# === QMCv1 (QQ音乐旧版 qmc*) ===
# QMCv1 mask，256 字节（hex 编码 = 512 hex 字符）
# 库会自动通过 from_qmcv1_mask256() 转换为 128 字节 mask
QMCV1_

# === KGM/VPR (酷狗音乐) ===
# KGM 解码表1，272 字节（hex 编码 = 544 hex 字符）
KGM_

# KGM 解码表2，272 字节
KGM_

# KGM 解码表v2 (MaskV2PreDef)，272 字节
KGM_

# VPR 密钥，17 字节（仅解密 .vpr 文件时需要）
VPR_KEY=25dfe8a6751e750e2f80f32db8b6e31100

# === KWM (酷我音乐) ===
# KWM 核心密钥（字符串）
KWM_CORE_KEY=MoOtOiTvINGwd2E6n0E1i7L5t2IoOoNk
